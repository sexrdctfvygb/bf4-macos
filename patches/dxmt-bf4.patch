+#pragma once
+// SPDX-License-Identifier: LGPL-2.1-or-later
+// BF4 Portable: optional successful-Present telemetry, 2026-10-10.
+// Successful DXGI Present intervals go to shared memory, never per-frame disk I/O.
+#include <windows.h>
+#include <cstdint>
+#include <cwchar>
+
+namespace dxmt {
+struct BF4FrameRecord {
+  volatile LONG64 sequence;
+  LONG64 timestamp;
+  LONG64 interval;
+  uint32_t flags;
+  uint32_t reserved;
+};
+struct BF4FrameHeader {
+  char magic[8];
+  uint32_t version;
+  uint32_t capacity;
+  uint32_t writer_pid;
+  uint32_t record_size;
+  volatile LONG64 committed;
+  LONG64 frequency;
+  LONG64 session;
+  LONG64 reserved[2];
+};
+static_assert(sizeof(BF4FrameHeader) == 64);
+static_assert(sizeof(BF4FrameRecord) == 32);
+
+class BF4FrameCapture {
+  static constexpr uint32_t capacity = 65536;
+  HANDLE file_ = INVALID_HANDLE_VALUE, mapping_ = nullptr;
+  BF4FrameHeader *header_ = nullptr;
+  BF4FrameRecord *records_ = nullptr;
+  LONG64 previous_ = 0, focus_check_ = 0, count_ = 0;
+  bool focused_ = false;
+public:
+  BF4FrameCapture() {
+    WCHAR process[MAX_PATH], destination[MAX_PATH];
+    if (!GetModuleFileNameW(nullptr, process, MAX_PATH)) return;
+    const WCHAR *name = wcsrchr(process, L'\\');
+    if (_wcsicmp(name ? name + 1 : process, L"bf4.exe")) return;
+    if (!GetEnvironmentVariableW(L"DXMT_BF4_FRAME_CAPTURE", destination, MAX_PATH)) return;
+    if (!wcscmp(destination, L"0")) return;
+    file_ = CreateFileW(destination, GENERIC_READ | GENERIC_WRITE,
+        FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE, nullptr, OPEN_ALWAYS,
+        FILE_ATTRIBUTE_NORMAL, nullptr);
+    if (file_ == INVALID_HANDLE_VALUE) return;
+    LARGE_INTEGER size;
+    size.QuadPart = sizeof(BF4FrameHeader) + capacity * sizeof(BF4FrameRecord);
+    if (!SetFilePointerEx(file_, size, nullptr, FILE_BEGIN) || !SetEndOfFile(file_)) return;
+    mapping_ = CreateFileMappingW(file_, nullptr, PAGE_READWRITE, 0, 0, nullptr);
+    if (!mapping_) return;
+    header_ = static_cast<BF4FrameHeader *>(MapViewOfFile(mapping_, FILE_MAP_WRITE, 0, 0, 0));
+    if (!header_) return;
+    ZeroMemory(header_, static_cast<SIZE_T>(size.QuadPart));
+    LARGE_INTEGER frequency, now;
+    QueryPerformanceFrequency(&frequency);
+    QueryPerformanceCounter(&now);
+    header_->version = 2;
+    header_->capacity = capacity;
+    header_->writer_pid = GetCurrentProcessId();
+    header_->record_size = sizeof(BF4FrameRecord);
+    header_->frequency = frequency.QuadPart;
+    header_->session = now.QuadPart;
+    records_ = reinterpret_cast<BF4FrameRecord *>(header_ + 1);
+    memcpy(header_->magic, "BF4FT02", 8);
+  }
+  ~BF4FrameCapture() {
+    if (header_) UnmapViewOfFile(header_);
+    if (mapping_) CloseHandle(mapping_);
+    if (file_ != INVALID_HANDLE_VALUE) CloseHandle(file_);
+  }
+  LONG64 present() {
+    if (!header_) return 0;
+    LARGE_INTEGER now;
+    QueryPerformanceCounter(&now);
+    bool continuity = previous_ > 0;
+    if (now.QuadPart - focus_check_ > header_->frequency / 20) {
+      DWORD foreground = 0;
+      GetWindowThreadProcessId(GetForegroundWindow(), &foreground);
+      bool focused = foreground == GetCurrentProcessId();
+      if (focused != focused_) continuity = false;
+      focused_ = focused;
+      focus_check_ = now.QuadPart;
+    }
+    if (previous_ > 0) {
+      LONG64 sequence = ++count_;
+      auto &record = records_[(sequence - 1) % capacity];
+      record.timestamp = now.QuadPart;
+      record.interval = now.QuadPart - previous_;
+      record.flags = (focused_ ? 1u : 0u) | (continuity ? 2u : 0u);
+      record.reserved = 0;
+      InterlockedExchange64(&record.sequence, sequence);
+      InterlockedExchange64(&header_->committed, sequence);
+    }
+    previous_ = now.QuadPart;
+    return count_;
+  }
+};
+inline LONG64 captureBF4Present() {
+  static BF4FrameCapture capture;
+  return capture.present();
+}
+}
